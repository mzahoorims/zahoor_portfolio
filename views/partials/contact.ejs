<section id="contact" class="section contact-section">
    <div class="container">
        <div class="contact-card">
            <div class="contact-content">
                <p class="section-label">GET IN TOUCH</p>
                <h2>Let's build something <span>useful.</span></h2>
                <p>
                    I am open to IT engineering, DevOps, cloud and software development opportunities.
                </p>
            </div>

            <div class="contact-buttons">
                <a href="<%= data.profile.socials.linkedin %>" target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                    Connect on LinkedIn ↗
                </a>
                <a href="<%= data.profile.socials.upwork %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                    Upwork Profile ↗
                </a>
            </div>
        </div>
    </div>
</section>
