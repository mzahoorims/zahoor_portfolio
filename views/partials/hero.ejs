<section id="home" class="hero section">
    <div class="container hero-container">
        <div class="hero-content">
            <div class="availability">
                <span class="status-dot"></span>
                <%= data.profile.statusText %>
            </div>

            <p class="hero-small-title">
                <%= data.profile.shortBio.split('•').join(' <span>•</span> ') %>
            </p>

            <h1 class="hero-name">
                <%= data.profile.name.split(' ')[0] %>
                <span><%= data.profile.name.split(' ').slice(1).join(' ') %>.</span>
            </h1>

            <p class="hero-description">
                <%= data.profile.bio %>
            </p>

            <div class="hero-buttons">
                <a href="#projects" class="btn btn-primary">
                    Explore Projects <span>↗</span>
                </a>
                <a href="<%= data.profile.socials.github %>" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
                    GitHub <span>↗</span>
                </a>
            </div>

            <div class="hero-socials">
                <a href="<%= data.profile.socials.github %>" target="_blank" rel="noopener noreferrer">GitHub</a>
                <span>/</span>
                <a href="<%= data.profile.socials.linkedin %>" target="_blank" rel="noopener noreferrer">LinkedIn</a>
                <span>/</span>
                <a href="<%= data.profile.socials.upwork %>" target="_blank" rel="noopener noreferrer">Upwork</a>
            </div>
        </div>

        <!-- TERMINAL COMPONENT -->
        <div class="terminal-wrapper">
            <div class="terminal-window">
                <div class="terminal-header">
                    <div class="terminal-dots">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                    <span class="terminal-title">zahoor@devops:~</span>
                </div>

                <div class="terminal-body" id="terminalBody">
                    <p>
                        <span class="terminal-green">zahoor@devops</span>:<span class="terminal-blue">~</span>$ whoami
                    </p>
                    <p class="terminal-output"><%= data.profile.name %></p>

                    <p>
                        <span class="terminal-green">zahoor@devops</span>:<span class="terminal-blue">~</span>$ focus
                    </p>
                    <p class="terminal-output">DevOps & Cloud Engineering</p>

                    <p>
                        <span class="terminal-green">zahoor@devops</span>:<span class="terminal-blue">~</span>$ stack
                    </p>
                    <p class="terminal-output">Docker • AWS • Kubernetes</p>
                    <p class="terminal-output">Linux • Git • CI/CD</p>

                    <p>
                        <span class="terminal-green">zahoor@devops</span>:<span class="terminal-blue">~</span>$ status
                    </p>
                    <p class="terminal-success">● SYSTEM READY</p>

                    <span class="cursor"></span>
                </div>
            </div>
        </div>
    </div>

    <!-- QUICK STATS -->
    <div class="container stats-container">
        <% data.stats.forEach(function(stat) { %>
            <div class="stat">
                <strong><%= stat.value %></strong>
                <span><%= stat.label %></span>
            </div>
        <% }); %>
    </div>
</section>
